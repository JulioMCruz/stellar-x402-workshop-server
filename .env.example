# Use testnet during the workshop. Switch all three values together for production.
STELLAR_NETWORK=stellar:testnet
FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
USDC_CONTRACT=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Public Stellar address that receives USDC. Never put a secret seed here.
PAY_TO=G_REPLACE_WITH_YOUR_RECEIVER_ADDRESS

# Generate a testnet key at https://channels.openzeppelin.com/testnet/gen
OPENZEPPELIN_API_KEY=replace_me

# Browser client origin. Use * locally or the exact deployed client URL.
CLIENT_ORIGIN=http://localhost:3001
