# STELLAR X402 WORKSHOP SERVER — TESTNET
#
# Setup:
#   npm ci
#   npm run setup
#   # Edit .env.local, then:
#   npm run preflight
#   npm run check
#   npm run dev
#
# Create and fund the receiver with Testnet XLM:
#   stellar keys generate workshop-receiver --network testnet --fund --secure-store
#   stellar keys address workshop-receiver
#
# Allow the receiver to hold Testnet USDC:
#   stellar tx new change-trust --network testnet --source-account workshop-receiver --line USDC:GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5 --limit 1000000
#
# Full wallet, faucet and testing instructions are in README.md.

# Keep these three Testnet values together. Do not mix Testnet and Mainnet.
STELLAR_NETWORK=stellar:testnet
FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
USDC_CONTRACT=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Public G-address printed by:
#   stellar keys address workshop-receiver
# Never put an S-secret or seed phrase here.
PAY_TO=G_REPLACE_WITH_YOUR_RECEIVER_ADDRESS

# Generate a Testnet API key at:
#   https://channels.openzeppelin.com/testnet/gen
# Server-only secret. Never rename it with a NEXT_PUBLIC_ prefix.
OPENZEPPELIN_API_KEY=replace_me

# Exact origin of the separate browser client. Restart after changing it.
CLIENT_ORIGIN=http://localhost:3001
